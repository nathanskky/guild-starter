<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnEmptyTestSuite="true">
    <testsuites>
        <testsuite name="guild-starter">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <php>
        <!-- Tests sign in as personas, which refuse to run beside real IU Login or Grouper secrets.
             force="true" wins over values already in the environment, such as a container
             started with docker/up-iu-services.sh. -->
        <env name="PERSONA_SIGN_IN_ENABLED" value="true" force="true"/>
        <env name="OIDC_CLIENT_SECRET" value="" force="true"/>
        <env name="GROUPER_PASSWORD" value="" force="true"/>
    </php>

    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
