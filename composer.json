{
    "name": "guild/starter",
    "description": "Starter project using the Guild Framework.",
    "type": "project",
    "authors": [
        {
            "name": "Nathan Skky Rodriguez",
            "email": "nsrodrig@iu.edu"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/nathanskky/guild-framework.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/nathanskky/guild-access.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/nathanskky/guild-rivet.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/nathanskky/guild-grouper.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/nathanskky/guild-dev-tools.git"
        }
    ],
    "require": {
        "php": "~8.5.0",
        "guild/framework": "^2.1.2",
        "guild/rivet": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.0",
        "laravel/pint": "^1.32",
        "guild/dev-tools": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Guild\\Starter\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Guild\\Starter\\Test\\": "tests"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "cp replacements/.gitignore.template .gitignore",
            "cp replacements/composer.json.template composer.json",
            "cp replacements/phpunit.xml.dist.template phpunit.xml.dist",
            "cp replacements/README.md.template README.md",
            "cp replacements/AGENTS.md.template AGENTS.md",
            "cp replacements/CLAUDE.md.template CLAUDE.md",
            "cp docker/.env.example docker/.env",
            "rm -rf replacements/",
            "rm -rf docs/",
            "rm -f .gitattributes",
            "git init --initial-branch=main"
        ],
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "pint",
        "format:check": "pint --test",
        "check": [
            "@format:check",
            "@analyse",
            "@test"
        ],
        "migrate": "phinx -c vendor/guild/framework/phinx.php migrate -e framework"
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit suite.",
        "analyse": "Run PHPStan static analysis. See phpstan.neon file for config.",
        "format": "Auto-fix code style with Pint (PSR-12).",
        "format:check": "Check code style with Pint (PSR-12) without modifying files.",
        "check": "Check style, run PHPStan, then the tests; stops at the first failure.",
        "migrate": "Run the framework's database migrations (and, later, the app's own). Needs the database, so run it in the container."
    }
}
