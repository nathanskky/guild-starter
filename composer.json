{
    "name": "guild/starter",
    "description": "Starter project using the Guild Framework.",
    "type": "project",
    "authors": [
        {
            "name": "Nathan Skky Rodriguez",
            "email": "nsrodrig@iu.edu"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/nathanskky/guild-framework.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/nathanskky/guild-access.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/nathanskky/guild-rivet.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/nathanskky/guild-grouper.git"
        }
    ],
    "require": {
        "php": "~8.5.0",
        "guild/framework": "dev-develop",
        "guild/rivet": "dev-develop"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "laravel/pint": "^1.32"
    },
    "autoload": {
        "psr-4": {
            "Guild\\Starter\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Guild\\Starter\\Test\\": "tests"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "php -r \"copy('replacements/.gitignore.template', '.gitignore');\"",
            "php -r \"copy('replacements/composer.json.template', 'composer.json');\"",
            "php -r \"copy('replacements/phpunit.xml.dist.template', 'phpunit.xml.dist');\"",
            "php -r \"copy('replacements/README.md.template', 'README.md');\"",
            "php -r \"copy('app.env.example', 'app.env');\"",
            "php -r \"copy('database.env.example', 'database.env');\"",
            "php -r \"copy('docker/.env.example', 'docker/.env');\"",
            "rm -rf replacements/",
            "rm -rf AGENTS.md",
            "rm -rf CLAUDE.md",
            "rm -rf .git",
            "git init --initial-branch=main"
        ],
        "test": "phpunit",
        "format": "pint",
        "format:check": "pint --test",
        "check": [
            "@test",
            "@format:check"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the test suite (fails if no tests run, which is the case until the first test is written).",
        "format": "Auto-fix code style with Pint (PSR-12).",
        "format:check": "Check code style with Pint (PSR-12) without modifying files.",
        "check": "Run tests then style check. There is no PHPStan configuration here; see AGENTS.md."
    }
}
