APP_HTTP_PORT=8080
APP_HTTPS_PORT=8443

# Do NOT add GROUPER_PASSWORD here.
# Compose substitutes ${VAR} from this file as well as from your shell, so a
# password placed here is a credential on disk -- exactly what the shell-injection
# approach avoids. Export it in your shell instead. The other GROUPER_* settings
# are not secrets and belong in app.env.
