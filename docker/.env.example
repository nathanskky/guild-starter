APP_HTTP_PORT=8080
APP_HTTPS_PORT=8443

# ID of the 1Password Environment holding this app's shared settings and secrets;
# ./up-iu-services.sh reads it. Not a secret itself: it grants nothing without access to the
# Environment. In the 1Password app: Developer > View Environments > (Environment) >
# Manage environment > Copy environment ID.
OP_ENVIRONMENT_ID=

# Personal overrides of any non-secret setting listed in docker-compose.yml go here,
# e.g. DEFAULT_TIMEZONE=America/Indiana/Indianapolis. The 1Password Environment
# still wins over a value set here.
#
# Do NOT add secrets here (OIDC_CLIENT_SECRET, GROUPER_PASSWORD). Compose reads this
# file, so a value placed here is a credential on disk. Put them in the 1Password
# Environment and start the stack with ./up-iu-services.sh instead; see README.
#
# PERSONA_SIGN_IN_ENABLED doesn't belong here either: the start scripts set it.
