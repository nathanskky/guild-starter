APP_HTTP_PORT=8080
APP_HTTPS_PORT=8443

# Do NOT add secrets here (OIDC_CLIENT_SECRET, GROUPER_PASSWORD, MAIL_PASSWORD,
# LDAP_PASSWORD). Compose substitutes ${VAR} from this file as well as from the
# environment, so a value placed here is a credential on disk. Reference them in
# ../secrets.env and start the stack with `op run` instead; see README.
